# ==============================================================
#  JamuyWasi — Nginx: sirve la web y reenvía /api al backend
#  ${API_UPSTREAM} se define en docker-compose (por defecto http://backend:8000)
# ==============================================================

# Caché en disco de las imágenes de productos/logos (servidas por la API)
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media_cache:20m
                 max_size=2g inactive=30d use_temp_path=off;

# Necesario para el WebSocket (Upgrade)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 12m;   # subida de imágenes (la API acepta hasta 10 MB)

    # DNS interno de Docker: resuelve "backend" en cada petición,
    # así Nginx arranca aunque el backend todavía no esté levantado.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # IMPORTANTE (seguridad): enviamos al backend SOLO la IP real de la conexión ($remote_addr),
    # no la cabecera X-Forwarded-For que mande el navegador; si no, cualquiera podría
    # inventarse otra IP y saltarse el límite de intentos del login.
    # Si pones Cloudflare u otro proxy delante, configura aquí set_real_ip_from + real_ip_header.
    set $api_upstream ${API_UPSTREAM};

    # ---------- Compresión ----------
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript
               text/javascript application/xml image/svg+xml;

    # ---------- Cabeceras de seguridad ----------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ---------- Salud del contenedor ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ---------- WebSocket en tiempo real ----------
    location = /api/ws {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # conexiones largas (el front envía ping cada 25 s)
        proxy_send_timeout 3600s;
    }

    # ---------- Imágenes (con caché en Nginx) ----------
    location /api/uploads/media/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache media_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Content-Type-Options "nosniff" always;
        expires 365d;
    }

    # ---------- API ----------
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # ---------- Archivos compilados (nombre con hash => caché de 1 año) ----------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ---------- index.html: nunca en caché (así cada despliegue se ve al instante) ----------
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ---------- Rutas de la SPA (/mi-tienda, ?product=...) ----------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
