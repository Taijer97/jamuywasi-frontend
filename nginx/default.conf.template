# ==============================================================
#  JamuyWasi — Nginx: sirve la web y reenvía /api al backend
#  ${API_UPSTREAM} se define en docker-compose (por defecto http://backend:8000)
#  ${MINIO_UPSTREAM} y ${MINIO_BUCKET}: MinIO, que sirve y recibe las imágenes directamente
# ==============================================================

# Caché en disco de las imágenes de productos/logos (servidas por MinIO)
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media_cache:20m
                 max_size=2g inactive=30d use_temp_path=off;

# Robots que generan la vista previa de enlaces (WhatsApp, Facebook, Telegram, X...).
# No ejecutan JavaScript, así que se les sirve un HTML con las etiquetas OG de la tienda/producto.
map $http_user_agent $is_preview_bot {
    default 0;
    ~*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|pinterest|skypeuripreview|viber|embedly|vkshare) 1;
}
# Solo páginas (no archivos como /brand/og-image.png o /assets/app.js)
map $uri $is_page_uri {
    default 1;
    "~\.[a-zA-Z0-9]{2,5}$" 0;   # entre comillas: Nginx exige comillas si la regex lleva { }
}
map "$is_preview_bot$is_page_uri" $serve_link_preview {
    default 0;
    "11" 1;
}

# Necesario para el WebSocket (Upgrade)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 6m;    # subida de imágenes (la API acepta hasta 5 MB; el navegador las comprime a <400 KB)

    # DNS interno de Docker: resuelve "backend" en cada petición,
    # así Nginx arranca aunque el backend todavía no esté levantado.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # IMPORTANTE (seguridad): enviamos al backend SOLO la IP real de la conexión ($remote_addr),
    # no la cabecera X-Forwarded-For que mande el navegador; si no, cualquiera podría
    # inventarse otra IP y saltarse el límite de intentos del login.
    # Si pones Cloudflare u otro proxy delante, configura aquí set_real_ip_from + real_ip_header.
    set $api_upstream ${API_UPSTREAM};
    set $minio_upstream ${MINIO_UPSTREAM};

    # ---------- Compresión ----------
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript
               text/javascript application/xml image/svg+xml;

    # ---------- Cabeceras de seguridad ----------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ---------- Salud del contenedor ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ---------- WebSocket en tiempo real ----------
    location = /api/ws {
        # La URL lleva el token de sesión (?token=...): no escribirla en los logs de Nginx
        access_log off;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # conexiones largas (el front envía ping cada 25 s)
        proxy_send_timeout 3600s;
    }

    # ---------- Imágenes: directo desde MinIO (sin pasar por el backend) + caché en Nginx ----------
    # Las URLs guardadas siguen siendo /api/uploads/media/<carpeta>/<archivo>, así no hay que migrar datos.
    location ~ "^/api/uploads/media/(products|logos|banners|uploads)/([A-Za-z0-9_.-]{1,120})$" {
        limit_except GET { deny all; }       # GET incluye HEAD
        proxy_pass $minio_upstream/${MINIO_BUCKET}/$1/$2;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";   # nunca reenviar credenciales a MinIO
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header X-Amz-Bucket-Region;
        proxy_hide_header X-Minio-Deployment-Id;
        proxy_hide_header Server;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache media_cache;
        proxy_cache_key $uri;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        # Si MinIO no responde o aún no tiene la lectura pública, se sirve por el backend como antes
        proxy_intercept_errors on;
        error_page 403 500 502 503 504 = @media_via_api;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location @media_via_api {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache media_cache;
        proxy_cache_key $uri;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Content-Type-Options "nosniff" always;
        expires 365d;
    }

    # Cualquier otra ruta de /api/uploads/media/ (nombres raros, carpetas no permitidas)
    location /api/uploads/media/ {
        return 404;
    }

    # ---------- Subida directa del navegador a MinIO (formulario firmado por el backend) ----------
    # El backend fija nombre, tipo y tamaño máximo; la foto no pasa por la API.
    location = /s3-upload {
        limit_except POST { deny all; }
        client_max_body_size 6m;
        proxy_pass $minio_upstream/${MINIO_BUCKET};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header X-Minio-Deployment-Id;
        proxy_hide_header Server;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        access_log off;   # el formulario lleva la firma en el cuerpo, no en la URL; igual no hace falta registrar
    }

    # ---------- API ----------
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # ---------- Archivos compilados (nombre con hash => caché de 1 año) ----------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ---------- index.html: nunca en caché (así cada despliegue se ve al instante) ----------
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ---------- Vista previa de enlaces para robots (WhatsApp, Facebook...) ----------
    location = /__link_preview {
        internal;
        proxy_pass $api_upstream/api/seo/render;
        proxy_http_version 1.1;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # ---------- Rutas de la SPA (/mi-tienda, ?product=...) ----------
    location / {
        if ($serve_link_preview) {
            rewrite ^ /__link_preview last;
        }
        try_files $uri $uri/ /index.html;
    }
}
